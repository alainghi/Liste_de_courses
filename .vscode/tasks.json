        {
            "label": "Build and Install Android App",
            "type": "shell",
            "command": "./gradlew installDebug",
            "windows": {
                "command": ".\\gradlew installDebug"
            },
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "showReuseMessage": false
            },
            "problemMatcher": "$gradle"
        },
        {
            "label": "Run Android App (Git Bash)",
            "type": "shell",
            "command": "\"$LOCALAPPDATA/Android/Sdk/platform-tools/adb\" shell am start -n \"fr.aghi.listedecourses/fr.aghi.listedecourses.MainActivity\" -a android.intent.action.MAIN -c android.intent.category.LAUNCHER",
            "options": {
                "shell": {
                    "executable": "C:\\Program Files\\Git\\bin\\bash.exe",
                    "args": ["-c"]
