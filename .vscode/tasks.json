{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start Android Emulator (Git Bash)",
            "type": "shell",
            "command": "cd \"$LOCALAPPDATA/Android/Sdk/emulator\" && ./emulator -avd Pixel_8 -read-only",
            "options": {
                "shell": {
                    "executable": "C:\\Program Files\\Git\\bin\\bash.exe",
                    "args": ["-c"]
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": [],
            "group": "none",
            "windows": {
                "command": "cd \"$LOCALAPPDATA/Android/Sdk/emulator\" && ./emulator -avd Pixel_8 -read-only"
            }
        },
        {
            "label": "Start Android Emulator (Windows CMD)",
